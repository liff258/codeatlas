# ============================================================
# CodeAtlas 环境变量模板
# 用法：复制本文件为 .env 并填入真实值。.env 已在 .gitignore 第一行，永不提交。
# ============================================================

# ---------- 数据库（Postgres 16 + pgvector）----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=codeatlas
POSTGRES_USER=codeatlas
POSTGRES_PASSWORD=change_me_in_local_env

# Python 侧使用的完整连接串（psycopg 格式，注意是 postgresql+psycopg://）
DATABASE_URL=postgresql+psycopg://codeatlas:change_me_in_local_env@localhost:5433/codeatlas

# Java 侧连接串（Spring 格式）
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/codeatlas
SPRING_DATASOURCE_USERNAME=codeatlas
SPRING_DATASOURCE_PASSWORD=change_me_in_local_env

# ---------- 模型服务（硅基流动，一个 key 走全链路）----------
# 注意：这组是 embedding API 的 key，和下面的 LLM_API_KEY 是两回事。
# 本地 embedding 用 bge-m3 时不需要填这里。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---------- Agent 对话模型（P2）----------
# 默认智谱 GLM-4.5-Flash：免费。注册 https://bigmodel.cn 后在「API Keys」页创建。
# 填好后把 MOCK_AGENT 改成 false，Agent 就会走真实推理。
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 注意是 glm-4.5-flash，不是上一代的 glm-4-flash
AGENT_MODEL=glm-4.5-flash

# Agent 走假流还是真实推理。填好 LLM_API_KEY 后改成 false。
# true 时用 mock_runner 的预录事件流（不需要 key，但答案是固定的）
MOCK_AGENT=true

# Chat 模型：主力 + 兜底
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
LLM_MODEL_FALLBACK=deepseek-ai/DeepSeek-V3

# Embedding（1024 维）
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=128

# Rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=true

# ---------- 服务间通信 ----------
# Java -> Python 的内网鉴权头，Python 侧校验 X-Internal-Token
INTERNAL_TOKEN=change_me_to_a_random_string

AGENT_SERVICE_HOST=localhost
AGENT_SERVICE_PORT=8000
AGENT_SERVICE_BASE_URL=http://localhost:8000

GATEWAY_PORT=8080

# ---------- Agent 预算与终止条件（防死循环的硬约束）----------
AGENT_MAX_STEPS=8
AGENT_MAX_REWRITE=2
AGENT_TIMEOUT_SECONDS=60
AGENT_TOKEN_BUDGET=30000
AGENT_COVERAGE_THRESHOLD=0.6
RETRIEVAL_TOP_K=20
RETRIEVAL_RRF_TOP_N=12

# ---------- 前端 ----------
VITE_API_BASE_URL=http://localhost:8080
# 设为 1 时前端走预录事件流回放，无网无 key 也能完整演示（10 分钟复现兜底路径）
VITE_MOCK=0

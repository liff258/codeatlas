# 统一行尾为 LF。
# 不加这个文件的话，Windows 上 core.autocrlf=true 会把 CRLF 写进索引，
# 别人在 macOS/Linux clone 下来每个文件都是满屏 diff——评审看提交历史时会很难受。
* text=auto eol=lf

# 二进制文件不做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary

# Windows 批处理必须保持 CRLF，否则跑不起来
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 锁文件在 diff 里不需要展开
package-lock.json linguist-generated=true
